{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "options": {
        "baseURL": "http://192.168.1.208:8000/v1"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (local)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4": {
          "name": "NVIDIA Nemotron-3 Super 120B (NVFP4)",
          "limit": {
            "context": 394000,
            "output": 8192
          }
        },
        "nvidia/Gemma-4-26B-A4B-NVFP4": {
          "name": "Gemma-4-26B-A4B-NVFP4",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "vllm/nvidia/Gemma-4-26B-A4B-NVFP4"
}
